{
  "private": true,
  "scripts": {
    "build": "esbuild src/infinitude-hvac-card.js --bundle --minify --format=esm --outfile=custom_components/infinitude_direct/www/infinitude-hvac-card.js",
    "release": "git push && git push origin --tags && node -e \"const v='v'+require('./custom_components/infinitude_direct/manifest.json').version; require('child_process').execSync('gh release create '+v+' --title '+v+' --generate-notes', {stdio:'inherit'})\"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "lit": "^3.0.0"
  }
}
